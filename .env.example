# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for SEO metadata, sitemap and OG tags.
# Local:      http://localhost:3002
# Vercel:     https://mostofa-portfolio.vercel.app
# Own domain: https://gtechsoft.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# ── Contact form (optional) ──────────────────────────────────
# The /api/contact route works without these (it logs + returns success),
# but to actually receive mail, sign up at https://resend.com (free tier),
# verify a domain, then set:
RESEND_API_KEY=
CONTACT_TO_EMAIL=golam.mostofa58@gmail.com
CONTACT_FROM_EMAIL=portfolio@yourdomain.com

# ── Analytics (optional) ─────────────────────────────────────
NEXT_PUBLIC_GA_ID=
